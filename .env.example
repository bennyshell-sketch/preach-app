# ─────────────────────────────────────────────────────────────────────────────
# Preach — environment configuration
# Copy to `.env` and fill in. Everything prefixed EXPO_PUBLIC_ is embedded in
# the client bundle and is therefore PUBLIC — never put a secret behind that
# prefix. Server-only keys live in Supabase Edge Function secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. Local/CI only — used by the ingestion + seed scripts.
# NEVER ships in the app bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Google OAuth (native sign-in) ────────────────────────────────────────────
# From Google Cloud Console → Credentials. iOS + Web client IDs are required by
# @react-native-google-signin; the Web client ID is what Supabase verifies.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Daily.co (study-room voice/video) ────────────────────────────────────────
# The API key is server-side only: the `create-room-token` Edge Function mints
# short-lived meeting tokens with it. The client never sees it.
DAILY_API_KEY=
EXPO_PUBLIC_DAILY_DOMAIN=your-team.daily.co

# ── API.Bible (scripture.api.bible) — CJB + TPT ──────────────────────────────
# Both translations are copyrighted and have NO free/open source. They light up
# only when this key is present AND the licence grant includes them. Absent the
# key the app runs fully on KJV / YLT / Interlinear.
# Held server-side; the `bible-proxy` Edge Function is the only caller.
API_BIBLE_KEY=
# Bible IDs within your licence grant (leave blank if not granted):
API_BIBLE_CJB_ID=
API_BIBLE_TPT_ID=

# ── Embeddings (semantic verse search) ───────────────────────────────────────
# Used at ingest time to populate verse_search_embeddings, and by the
# `embed-query` Edge Function to embed the user's search string.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
