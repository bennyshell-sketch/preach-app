    "ingest:embeddings": "tsx scripts/ingest/generate-embeddings.ts",
    "ingest:all": "npm run ingest:bible && npm run ingest:interlinear && npm run ingest:strongs && npm run ingest:crossrefs && npm run ingest:embeddings",
